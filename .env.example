# Copy to .env and adjust. All optional; defaults shown.
PORT=8787
# Interface to listen on. 127.0.0.1 (default) = this machine only. The backend has NO authentication:
# use 0.0.0.0 only in a trusted network, or keep 127.0.0.1 behind a reverse proxy with HTTPS / access control.
HOST=127.0.0.1
# Where sessions (workspace, event log, proposals) live. Keep it OUTSIDE this repo: Claude Code
# loads .claude/ and CLAUDE.md from every parent directory of the agent's cwd up to the repo root.
SESSIONS_DIR=../asdf10k-agentic-sessions
# Close a session's live Claude Code process after this many idle minutes (resumed on the next message).
IDLE_CLOSE_MIN=15
# 1 = scripted fake agent, no Claude calls (for frontend work and tests).
AGENT_FAKE=0
# Voice input (push-to-talk in the Agent window) through whisper.cpp. All optional: the binary is
# looked up on PATH (brew install whisper-cpp) and the best ggml-*.bin in WHISPER_MODELS_DIR is used.
# Recommended model: ggml-large-v3-turbo-q8_0.bin (874 MB, https://huggingface.co/ggerganov/whisper.cpp).
#WHISPER_CPP_BIN=/opt/homebrew/bin/whisper-cli
WHISPER_MODELS_DIR=../asdf10k-agentic-models
#WHISPER_MODEL=../asdf10k-agentic-models/ggml-large-v3-turbo-q8_0.bin
WHISPER_LANG=auto
WHISPER_THREADS=4
# Stall watchdog: a run without any message from the model for RUN_STALL_WARN_S seconds shows
# "waiting" in the window; after RUN_STALL_ABORT_MIN minutes it is stopped with an error.
RUN_STALL_WARN_S=90
RUN_STALL_ABORT_MIN=10
# Agent model and reasoning effort (session agent) and the model of the "What's up?" side query.
# Defaults: Sonnet 5.5 at medium effort (about 3x faster than Opus at high effort for app work);
# AGENT_MODEL=claude-opus-5-5 AGENT_EFFORT=high for heavier research sessions.
AGENT_MODEL=claude-sonnet-5-5
AGENT_EFFORT=medium
ASIDE_MODEL=claude-haiku-4-5-20251001
